{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GG-O-BP/mendimaru/schemas/browser.schema.json",
  "title": "Mendimaru browser test contracts",
  "$defs": {
    "environmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "managedVm",
        "managementGeneration",
        "container",
        "containerRunning",
        "compose",
        "publishedPorts",
        "runtime",
        "studio",
        "build",
        "buildWatchGeneration"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "managedVm": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "managementGeneration": {
          "type": ["string", "null"],
          "pattern": "^(uninitialized|[a-f0-9]{32})$"
        },
        "container": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "containerRunning": {
          "type": ["boolean", "null"]
        },
        "compose": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "publishedPorts": {
          "type": ["array", "null"],
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guest", "protocol", "host", "addressDigest"],
            "properties": {
              "guest": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": ["tcp", "udp", "sctp"]
              },
              "host": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "addressDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "runtime": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "studio": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["processId", "startedAt", "running"],
              "properties": {
                "processId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "running": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "build": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "buildWatchGeneration": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "preparationId",
        "baseline",
        "latest",
        "observations",
        "events",
        "comparable",
        "missing",
        "actor",
        "intervalMilliseconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "preparationId": {
          "type": "string",
          "pattern": "^preparation_[a-f0-9]{32}$"
        },
        "baseline": {
          "$ref": "#/$defs/environmentSnapshot"
        },
        "latest": {
          "$ref": "#/$defs/environmentSnapshot"
        },
        "observations": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "component", "observation"],
            "properties": {
              "classification": {
                "enum": [
                  "environment-changed",
                  "session-lost",
                  "build-changed",
                  "observation-unavailable"
                ]
              },
              "component": {
                "enum": [
                  "managed-vm",
                  "container",
                  "compose",
                  "published-ports",
                  "runtime",
                  "studio",
                  "build"
                ]
              },
              "observation": {
                "$ref": "#/$defs/environmentSnapshot"
              }
            }
          }
        },
        "comparable": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "managed-vm",
              "container",
              "compose",
              "published-ports",
              "runtime",
              "studio",
              "build"
            ]
          }
        },
        "actor": {
          "const": "unknown"
        },
        "intervalMilliseconds": {
          "const": 1000
        }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runnerVersion",
        "ready",
        "nodeVersion",
        "minimumNodeVersion",
        "nodeSupported",
        "playwrightVersion",
        "chromium",
        "downloadPolicy"
      ],
      "properties": {
        "schemaVersion": { "const": "4.0.0" },
        "runnerVersion": { "const": "1.0.0" },
        "ready": { "type": "boolean" },
        "nodeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(unavailable|[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "minimumNodeVersion": { "const": "22.22.2" },
        "nodeSupported": { "type": "boolean" },
        "playwrightVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(unavailable|[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "chromium": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed", "launchable"],
          "properties": {
            "installed": { "type": "boolean" },
            "launchable": { "type": "boolean" },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "downloadPolicy": { "const": "explicit-only" },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "$ref": "#/$defs/prerequisiteCheck",
              "type": "object",
              "properties": { "id": { "const": "runner" } }
            },
            {
              "$ref": "#/$defs/prerequisiteCheck",
              "type": "object",
              "properties": { "id": { "const": "node" } }
            },
            {
              "$ref": "#/$defs/prerequisiteCheck",
              "type": "object",
              "properties": { "id": { "const": "node_version" } }
            },
            {
              "$ref": "#/$defs/prerequisiteCheck",
              "type": "object",
              "properties": { "id": { "const": "js_dependencies" } }
            },
            {
              "$ref": "#/$defs/prerequisiteCheck",
              "type": "object",
              "properties": { "id": { "const": "chromium" } }
            }
          ],
          "items": false
        },
        "diagnostic": { "$ref": "#/$defs/doctorDiagnostic" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ready": { "const": true } },
            "required": ["ready"]
          },
          "then": {
            "properties": {
              "nodeSupported": { "const": true },
              "chromium": {
                "type": "object",
                "required": ["version"],
                "properties": {
                  "installed": { "const": true },
                  "launchable": { "const": true },
                  "version": { "type": "string" }
                }
              },
              "nodeVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "playwrightVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "status": { "const": "passed" } }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["checks"],
            "properties": { "ready": { "const": false } }
          },
          "then": {
            "required": ["diagnostic"],
            "properties": {
              "diagnostic": { "$ref": "#/$defs/doctorDiagnostic" },
              "checks": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "status": { "const": "failed" } }
                }
              }
            }
          }
        }
      ]
    },
    "prerequisiteCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "message", "action"],
      "properties": {
        "id": {
          "enum": [
            "runner",
            "node",
            "node_version",
            "js_dependencies",
            "chromium"
          ]
        },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "code": {
          "enum": [
            "runner_missing",
            "runner_unreadable",
            "unsafe_override",
            "node_missing",
            "node_spawn_denied",
            "node_spawn_failed",
            "node_unsupported",
            "node_probe_failed",
            "probe_timeout",
            "js_dependencies_missing",
            "runner_failed",
            "runner_output_invalid",
            "chromium_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "action": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": { "required": ["code"], "properties": { "code": true } },
          "else": {
            "not": { "required": ["code"], "properties": { "code": true } }
          }
        }
      ]
    },
    "doctorDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "stored", "stderrTruncated", "stdoutTruncated"],
      "properties": {
        "reference": { "const": "browser-doctor-latest" },
        "stored": { "type": "boolean" },
        "stderrTruncated": { "type": "boolean" },
        "stdoutTruncated": { "type": "boolean" },
        "errorKind": {
          "enum": [
            "ERR_MODULE_NOT_FOUND",
            "MODULE_NOT_FOUND",
            "ERR_PACKAGE_PATH_NOT_EXPORTED",
            "ERR_DLOPEN_FAILED",
            "SyntaxError",
            "TypeError",
            "ReferenceError"
          ]
        },
        "module": {
          "enum": [
            "@playwright/test",
            "playwright-core",
            "playwright",
            "fflate",
            "browser-artifact-safety.mjs",
            "browser-frontend-health.mjs"
          ]
        }
      }
    },
    "outcome": { "enum": ["passed", "failed", "skipped"] },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "completedSteps", "totalSteps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "completedSteps": { "type": "integer", "minimum": 0 },
        "totalSteps": { "type": "integer", "minimum": 0 },
        "failure": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigationTimeoutMilliseconds",
        "actionTimeoutMilliseconds",
        "assertionTimeoutMilliseconds",
        "failOnConsoleError",
        "failOnNetworkFailure",
        "recordVideo",
        "recordHar",
        "maxArtifactBytes",
        "retentionRuns"
      ],
      "properties": {
        "navigationTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "actionTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "assertionTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "failOnConsoleError": { "type": "boolean" },
        "failOnNetworkFailure": { "type": "boolean" },
        "recordVideo": { "type": "boolean" },
        "recordHar": { "type": "boolean" },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 536870912
        },
        "retentionRuns": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sessionId",
        "outcome",
        "passed",
        "failed",
        "skipped",
        "startedAt",
        "finishedAt",
        "browserName",
        "browserVersion",
        "playwrightVersion",
        "tests",
        "artifacts"
      ],
      "properties": {
        "environment": { "$ref": "#/$defs/environment" },
        "schemaVersion": { "const": "4.0.0" },
        "sessionId": { "type": "string", "pattern": "^session_[0-9a-f]{32}$" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "browserName": { "const": "chromium" },
        "browserVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "playwrightVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/testCase" }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "https://github.com/GG-O-BP/mendimaru/schemas/artifact.schema.json"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sessionId",
        "createdAt",
        "hostPlatform",
        "studioPlatform",
        "backend",
        "runtimeMode",
        "browser",
        "playwrightVersion",
        "runnerVersion",
        "suite",
        "policy",
        "artifacts"
      ],
      "properties": {
        "environment": { "$ref": "#/$defs/environment" },
        "schemaVersion": { "const": "4.0.0" },
        "sessionId": { "type": "string", "pattern": "^session_[0-9a-f]{32}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "hostPlatform": {
          "enum": ["linux", "windows", "macos", "unsupported"]
        },
        "studioPlatform": {
          "enum": ["linux", "windows", "macos", "unsupported"]
        },
        "runtimePlatform": { "enum": ["linux", "windows", "macos"] },
        "backend": {
          "enum": ["linux-winboat", "windows-native", "mac-native"]
        },
        "runtimeMode": {
          "enum": ["portable", "studio-run-locally", "external-url"]
        },
        "studioVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "chromium" },
            "version": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },
        "playwrightVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "runnerVersion": { "const": "1.0.0" },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "tests"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 160 },
            "tests": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "artifacts": {
          "type": "array",
          "maxItems": 511,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "kind", "mediaType", "sha256", "sizeBytes"],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,120}$"
              },
              "kind": {
                "enum": [
                  "browser-trace",
                  "browser-report",
                  "screenshot",
                  "ui-tree",
                  "dom-snapshot",
                  "diagnostic"
                ]
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sizeBytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
