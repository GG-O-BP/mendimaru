{
  "name": "mendimaru",
  "private": true,
  "version": "0.2.1",
  "description": "Manage Mendix Studio Pro natively on Windows or through WinBoat on Linux",
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:frontend && npm run test:backend && npm run test:contracts",
    "test:frontend": "vitest run",
    "test:app-flow": "vitest run src/App.e2e.test.tsx",
    "test:e2e": "node scripts/test-tauri-e2e.mjs",
    "test:e2e:windows": "node scripts/e2e/windows-native.mjs",
    "test:e2e:windows:build": "cargo build --manifest-path src-tauri/Cargo.toml --features e2e",
    "test:winboat-smoke": "node scripts/test-winboat-e2e.mjs --smoke",
    "test:winboat-e2e": "node scripts/test-winboat-e2e.mjs --lifecycle",
    "test:browser": "node scripts/test-browser-e2e.mjs",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:contracts": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- capabilities --json | node scripts/validate-backend-contract.mjs",
    "test:security": "npm audit --audit-level=high",
    "lint": "npm run lint:frontend && npm run lint:rust",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:rust:all-features": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:portable": "npm run lint && npm run format:check && npm run build && npm run test",
    "check": "npm run check:portable && npm run test:winboat-e2e",
    "check:windows": "npm run check:portable && npm run lint:rust:all-features && npm run test:security && npm run test:e2e:windows",
    "preview": "vite preview",
    "tarui": "npm run tauri --",
    "tauri": "cross-env NO_STRIP=1 tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fflate": "0.8.3",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
