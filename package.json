{
  "name": "mendimaru",
  "private": true,
  "version": "0.5.0",
  "description": "Manage Mendix Studio Pro natively on Windows or through WinBoat on Linux",
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:frontend && npm run test:motion && npm run test:perf && npm run test:ci:gates && npm run test:e2e:windows:helpers && npm run test:browser:security && npm run test:browser:winboat:helpers && npm run test:e2e:studio-parity && npm run test:rustsec-policy && npm run test:backend && npm run test:contracts",
    "test:frontend": "vitest run",
    "test:app-flow": "vitest run src/App.e2e.test.tsx",
    "test:motion": "node scripts/verify-motion-contract.mjs",
    "test:e2e": "node scripts/test-tauri-e2e.mjs",
    "test:e2e:coverage": "node scripts/verify-e2e-coverage.mjs",
    "test:e2e:windows:helpers": "node --test scripts/e2e/windows-native-helpers.node-test.mjs",
    "test:e2e:studio-parity": "node --test scripts/e2e/studio-f5-parity-gate.node-test.mjs",
    "test:e2e:windows:powershell": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/e2e/windows-bundle-smoke.test.ps1",
    "test:e2e:windows": "npm run test:e2e:windows:build && node scripts/e2e/windows-native.mjs",
    "test:e2e:windows:build": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --features e2e",
    "test:perf": "node scripts/ci/node-test-suite.mjs scripts/perf",
    "test:ci:gates": "node scripts/ci/node-test-suite.mjs scripts/ci",
    "test:perf:release:build": "npm run tauri -- build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:winboat-smoke": "node scripts/test-winboat-e2e.mjs --smoke",
    "test:winboat-e2e": "node scripts/test-winboat-e2e.mjs --lifecycle",
    "test:browser": "node scripts/test-browser-e2e.mjs && npm run test:browser:frontend",
    "test:browser:security": "node --test scripts/browser-artifact-safety.node-test.mjs",
    "test:browser:winboat": "node scripts/test-browser-winboat-live.mjs",
    "test:browser:winboat:helpers": "node --test scripts/browser-winboat-live.node-test.mjs scripts/browser-environment.node-test.mjs",
    "test:browser:environment:live": "cargo test --manifest-path src-tauri/Cargo.toml --lib live_environment_generation_gate -- --ignored --nocapture",
    "test:browser:environment:fixtures": "cargo test --manifest-path src-tauri/Cargo.toml --lib external_environment_changes_preserve_browser_evidence -- --ignored --nocapture",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:contracts": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- capabilities --json | node scripts/validate-backend-contract.mjs",
    "test:rustsec-policy": "node --test scripts/rustsec-policy.node-test.mjs",
    "test:security": "npm audit --audit-level=high",
    "lint": "npm run lint:frontend && npm run lint:rust",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:rust:all-features": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:portable": "npm run lint && npm run format:check && npm run build && npm run test",
    "check": "npm run check:portable && npm run test:winboat-e2e",
    "check:windows": "npm run check:portable && npm run test:e2e:windows:powershell && npm run lint:rust:all-features && npm run test:security && npm run test:e2e:windows",
    "preview": "vite preview",
    "tarui": "npm run tauri --",
    "tauri": "cross-env NO_STRIP=1 tauri",
    "test:browser:frontend": "node --test scripts/browser-frontend-health.node-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fflate": "0.8.3",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
