# JavaScript dependencies and frontend build output
/node_modules/
/dist/
/dist-ssr/
/coverage/
/.nyc_output/

# Rust and Tauri generated output
/src-tauri/target/
/src-tauri/gen/schemas/
**/*.rs.bk
*.pdb

# Mendimaru runtime files (downloaded installers and operation reports)
/.mendimaru/

# Local environment and secret files
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor-specific files
/.idea/
/.vscode/*
!/.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-*
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.backup
