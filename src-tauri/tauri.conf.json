{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mendimaru",
  "version": "0.1.0",
  "identifier": "com.ggobp.mendimaru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mendimaru — Mendix Studio Pro Manager",
        "width": 1240,
        "height": 790,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/browser-runner.mjs": "browser/browser-runner.mjs",
      "../node_modules/@playwright/test/": "browser/node_modules/@playwright/test/",
      "../node_modules/fflate/": "browser/node_modules/fflate/",
      "../node_modules/playwright/": "browser/node_modules/playwright/",
      "../node_modules/playwright-core/": "browser/node_modules/playwright-core/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
