{
  "schemaVersion": "1.0.0",
  "name": "Mendix fixture bounded parallel",
  "beforeEach": [
    { "action": "goto", "path": "/" },
    {
      "action": "fill",
      "locator": { "by": "label", "value": "Username" },
      "valueFromEnv": "MENDIMARU_TEST_USERNAME",
      "sensitive": false
    },
    {
      "action": "fill",
      "locator": { "by": "label", "value": "Password" },
      "valueFromEnv": "MENDIMARU_TEST_PASSWORD"
    },
    {
      "action": "click",
      "locator": { "by": "role", "role": "button", "name": "Sign in" }
    },
    {
      "action": "expectVisible",
      "locator": { "by": "role", "role": "heading", "name": "Task board" }
    }
  ],
  "maskLocators": [{ "by": "testId", "value": "private-output" }],
  "tests": [
    {
      "name": "stable app read: the board reports its idle status",
      "concurrency": { "resource": "app-read" },
      "steps": [
        {
          "action": "expectText",
          "locator": { "by": "role", "role": "status", "name": "Result" },
          "value": "Waiting"
        }
      ]
    },
    {
      "name": "stable app read: the task input starts empty",
      "concurrency": { "resource": "app-read" },
      "steps": [
        {
          "action": "expectValue",
          "locator": { "by": "mendixName", "value": "TaskInput" },
          "value": ""
        }
      ]
    },
    {
      "name": "stable app read: the add-task command stays available",
      "concurrency": { "resource": "app-read" },
      "steps": [
        {
          "action": "expectVisible",
          "locator": { "by": "role", "role": "button", "name": "Add task" }
        }
      ]
    },
    {
      "name": "isolated data write: save a task in its own scope",
      "concurrency": {
        "resource": "data-write",
        "scope": "fixture-tasks",
        "isolation": "verified"
      },
      "steps": [
        {
          "action": "fill",
          "locator": { "by": "mendixName", "value": "TaskInput" },
          "value": "Scoped order"
        },
        {
          "action": "click",
          "locator": { "by": "mendixName", "value": "AddTask" }
        },
        {
          "action": "expectText",
          "locator": { "by": "role", "role": "status", "name": "Result" },
          "value": "Saved: Scoped order"
        }
      ]
    },
    {
      "name": "isolated data write: reuse the same proven scope",
      "concurrency": {
        "resource": "data-write",
        "scope": "fixture-tasks",
        "isolation": "verified"
      },
      "steps": [
        {
          "action": "fill",
          "locator": { "by": "mendixName", "value": "TaskInput" },
          "value": "Second scoped order"
        },
        {
          "action": "click",
          "locator": { "by": "mendixName", "value": "AddTask" }
        },
        {
          "action": "expectText",
          "locator": { "by": "role", "role": "status", "name": "Result" },
          "value": "Saved: Second scoped order"
        }
      ]
    },
    {
      "name": "undeclared legacy test joins the serial data group",
      "steps": [
        {
          "action": "check",
          "locator": { "by": "label", "value": "Done" }
        },
        {
          "action": "expectVisible",
          "locator": { "by": "role", "role": "heading", "name": "Task board" }
        }
      ]
    }
  ]
}
